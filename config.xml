<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://vortixtvv2/VortixTV" version="2.2.0" viewmodes="maximized">
    <name>VortixTV</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'self' data: blob: filesystem: 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; script-src * 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; media-src * data: blob: http://127.0.0.1:3001 https:; connect-src * data: blob: http://127.0.0.1:3001 https: http: ws: wss:; frame-src * http://127.0.0.1:3001 http://127.0.0.1:3000 https://www.youtube.com https://www.youtube-nocookie.com;</tizen:content-security-policy>
    <tizen:application id="vortixtvv2.VortixTV" package="vortixtvv2" required_version="4.0"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.display"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drmplay"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://tizen.org/privilege/mediastorage"/>
    <tizen:privilege name="http://tizen.org/privilege/externalstorage"/>
    <tizen:service id="vortixtvv2.StalkerProxy" auto-restart="true" on-boot="false">
        <tizen:content src="service/proxy.js"/>
        <tizen:name>StalkerProxyV2</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Local Header Proxy v2.2.0</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
